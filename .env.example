# Copy to .env and fill in. Never commit .env.

# Supabase project (auth, database, storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: AI chat and DALL-E image generation.
# A VITE_ variable is bundled into the browser build, so use a restricted key
# and never deploy a build that contains it publicly.
VITE_OPENAI_API_KEY=

# Optional: Google image search (Custom Search JSON API)
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_SEARCH_ENGINE_ID=

# Optional: Google Fonts list
VITE_GOOGLE_FONTS_API_KEY=
